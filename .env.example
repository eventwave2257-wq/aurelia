# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform JS, Places & Routes APIs.
# Configure via Google Maps Setup or AI Studio Secrets panel.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CCAVENUE_MERCHANT_ID, CCAVENUE_ACCESS_CODE & CCAVENUE_WORKING_KEY: Required for live CCAvenue UPI, Card & NetBanking checkout.
# CCAVENUE_ENV ("test" or "production") selects test.ccavenue.com vs secure.ccavenue.com.
# When omitted, server runs in verifiable CCAvenue AES-128-CBC Sandbox mode.
CCAVENUE_MERCHANT_ID="MY_CCAVENUE_MERCHANT_ID"
CCAVENUE_ACCESS_CODE="MY_CCAVENUE_ACCESS_CODE"
CCAVENUE_WORKING_KEY="MY_CCAVENUE_WORKING_KEY"
CCAVENUE_ENV="test"
